{
  "name": "njit-empty-rooms",
  "private": true,
  "scripts": {
    "start": "python app.py",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o static/tailwind.css --minify",
    "check:css": "out=$(mktemp); trap 'rm -f \"$out\"' EXIT; tailwindcss -c tailwind.config.js -i tailwind.src.css -o \"$out\" --minify && cmp static/tailwind.css \"$out\"",
    "update:cache": "node scripts/cache-fingerprint.js --update",
    "check:cache": "node scripts/cache-fingerprint.js --check",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test infrastructure.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "tailwindcss": "3.4.19"
  }
}
